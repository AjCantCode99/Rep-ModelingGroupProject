                Official Florida Tourism
            </a>
        </p>

        <p>
            2026 Florida Travel Guide. Educational Project.
        </p>

    </footer>

    <script> <!--javascript for the navbar-->
        function myFunction(x) {
            x.classList.toggle("change");
            document.getElementById("menu").classList.toggle("open");
        }
